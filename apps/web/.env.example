# Base URL of the Gold Trader's Edge API (packages/api). Without this the
# app silently falls back to http://localhost:8000.
NEXT_PUBLIC_API_URL=https://the-gold-traders-edge-production.up.railway.app

# Shared password gating /controls (see middleware.ts). Server-only — never
# prefix with NEXT_PUBLIC_. Without this set, /controls fails closed (always
# redirects to login, which shows a config error) rather than being left open.
CONTROLS_PASSWORD=change-me
